{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DVICode Build Configuration",
  "scopeName": "source.dvicode-build",
  "patterns": [
    { "name": "comment.line.double-slash.build", "match": "//.*$" },
    { "name": "comment.line.number-sign.build", "match": "#.*$" },
    { "name": "comment.line.double-dash.build", "match": "^\\s*--.*$" },
    { "name": "comment.block.build", "begin": "/\\*", "end": "\\*/" },
    { "name": "string.quoted.double.build", "begin": "\"", "end": "\"" },
    { "name": "string.quoted.single.build", "begin": "'", "end": "'" },
    {
      "match": "(\\+dvicode_[a-z_]+)(\\+[^\\s]*)?",
      "captures": {
        "1": { "name": "keyword.control.tool.build" },
        "2": { "name": "string.unquoted.argument.build" }
      }
    },
    {
      "match": "(\\+[a-zA-Z_]+)(\\+[^\\s]*)?",
      "captures": {
        "1": { "name": "keyword.other.directive.build" },
        "2": { "name": "string.unquoted.argument.build" }
      }
    },
    { "name": "keyword.other.option.build", "match": "(?<=^|\\s)-[a-zA-Z_][a-zA-Z0-9_]*" },
    { "name": "variable.other.environment.build", "match": "\\$\\{[^}]+\\}|\\$\\([^)]+\\)|\\$[a-zA-Z_][a-zA-Z0-9_]*|%[a-zA-Z_][a-zA-Z0-9_]*%" }
  ]
}
