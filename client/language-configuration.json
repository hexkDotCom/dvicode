{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["begin", "end"],
    ["fork", "join"],
    ["case", "endcase"],
    ["class", "endclass"],
    ["module", "endmodule"],
    ["interface", "endinterface"],
    ["package", "endpackage"],
    ["function", "endfunction"],
    ["task", "endtask"],
    ["program", "endprogram"],
    ["covergroup", "endgroup"],
    ["generate", "endgenerate"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "(\\\\\\S+)|([a-zA-Z_][a-zA-Z0-9_$]*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(.*\\bbegin\\b(\\s*:\\s*\\w+)?|.*\\bfork\\b|.*\\b(case|casex|casez|randcase)\\b.*|(?!(extern|pure|virtual\\s+interface)\\b)((virtual|local|protected|static|automatic)\\s+)*(class|module|macromodule|interface|program|package|function|task|covergroup|clocking|property|sequence|generate|checker|primitive|config)\\b(?!.*\\bend(class|module|interface|program|package|function|task|group|clocking|property|sequence|generate|checker|primitive|config)\\b).*)\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*(end|endcase|endclass|endmodule|endinterface|endprogram|endpackage|endfunction|endtask|endgroup|endclocking|endproperty|endsequence|endgenerate|endchecker|endprimitive|endconfig|join|join_any|join_none)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  }
}
