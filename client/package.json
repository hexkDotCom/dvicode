{
  "name": "dvicode",
  "displayName": "DVICode - DV Intelligence",
  "description": "SystemVerilog and UVM navigation, problems, design and UVM hierarchies, and macro expansion, from a fast Rust engine that runs natively on Windows, Linux and macOS, in WSL, or on a Linux server over SSH.",
  "version": "0.5.0",
  "publisher": "hexk",
  "license": "Apache-2.0",
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#182030",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hexkDotCom/dvicode.git"
  },
  "bugs": {
    "url": "https://github.com/hexkDotCom/dvicode/issues"
  },
  "homepage": "https://github.com/hexkDotCom/dvicode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, DVICode ignores the workspace's settings for which engine to run and where (program path, launch command, SSH and TCP targets, extra arguments) and does not connect to an SSH or TCP engine that a dvicode:// folder names unless your own settings name it too; your own user settings still apply.",
      "restrictedConfigurations": [
        "dvicode.server.mode",
        "dvicode.server.path",
        "dvicode.server.wslDistro",
        "dvicode.server.sshHost",
        "dvicode.server.sshArgs",
        "dvicode.server.sshCommand",
        "dvicode.server.launchCommand",
        "dvicode.server.tcpAddress",
        "dvicode.server.extraArgs",
        "dvicode.server.logLevel"
      ]
    }
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "systemverilog",
    "verilog",
    "uvm",
    "verification",
    "hdl",
    "sv",
    "verilog-hdl",
    "system verilog",
    "language server",
    "lsp",
    "design verification",
    "dv",
    "asic",
    "fpga",
    "rtl",
    "testbench",
    "eda",
    "ssh",
    "wsl"
  ],
  "icon": "images/icon.png",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:systemverilog",
    "onLanguage:verilog",
    "workspaceContains:.dvicode",
    "workspaceContains:**/*.{sv,svh}",
    "onFileSystem:dvicode"
  ],
  "contributes": {
    "languages": [
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh",
          ".svi",
          ".svp",
          ".sva",
          ".v",
          ".vh",
          ".vp",
          ".vlib"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dvicode-build",
        "aliases": [
          "DVICode Build Configuration",
          "buildconfig"
        ],
        "extensions": [
          ".build",
          ".f"
        ],
        "configuration": "./build-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      },
      {
        "language": "dvicode-build",
        "scopeName": "source.dvicode-build",
        "path": "./syntaxes/build.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "systemverilog",
        "path": "./snippets/systemverilog.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "module",
        "superType": "class",
        "description": "Module, program or checker"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "port",
        "description": "Port of a module or interface"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "systemverilog",
        "scopes": {
          "module": [
            "entity.name.type.module.systemverilog"
          ],
          "variable.readonly": [
            "variable.other.constant.systemverilog"
          ],
          "parameter.port": [
            "variable.parameter.port.systemverilog"
          ]
        }
      }
    ],
    "configuration": {
      "title": "DVICode",
      "properties": {
        "dvicode.server.mode": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "wsl",
            "ssh",
            "tcp",
            "custom"
          ],
          "enumDescriptions": [
            "Use the engine bundled for this machine for local folders; WSL for \\wsl$ / \\wsl.localhost folders (and on Windows when no Windows engine is bundled); the host of a dvicode:// folder.",
            "Run the server on this machine.",
            "Run the server in a WSL distribution (Windows only).",
            "Run the server on `#dvicode.server.sshHost#` over SSH (keys or an agent must be set up).",
            "Connect to a running `dvicode-server --listen` at `#dvicode.server.tcpAddress#`.",
            "Run `#dvicode.server.launchCommand#`, which must contain ${SERVER_CMD} (e.g. for bsub/qrsh)."
          ],
          "default": "auto",
          "scope": "machine-overridable",
          "description": "Where the DVICode language server runs."
        },
        "dvicode.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path of dvicode-server on the machine where it runs. Empty: use the bundled binary (deployed to ~/.dvicode/server/<version> for WSL and SSH)."
        },
        "dvicode.server.autoDeploy": {
          "type": "boolean",
          "default": true,
          "description": "Copy the bundled Linux server to the WSL distribution or SSH host when it is missing there."
        },
        "dvicode.server.wslDistro": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "WSL distribution for the server. Empty: the distribution of a \\\\wsl$ folder, else the default distribution."
        },
        "dvicode.server.sshHost": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "SSH destination for the server, e.g. `user@build-server` or a Host alias from ~/.ssh/config."
        },
        "dvicode.server.sshArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Extra arguments for ssh, e.g. [\"-p\", \"2222\", \"-i\", \"~/.ssh/id_ed25519\"]."
        },
        "dvicode.server.sshCommand": {
          "type": "string",
          "default": "ssh",
          "scope": "machine-overridable",
          "description": "The ssh executable."
        },
        "dvicode.server.launchCommand": {
          "type": "string",
          "default": "${SERVER_CMD}",
          "scope": "machine-overridable",
          "description": "Command for the `custom` mode. ${SERVER_CMD} is replaced by the server command line, e.g. `ssh farm bsub -Is ${SERVER_CMD}`."
        },
        "dvicode.server.tcpAddress": {
          "type": "string",
          "default": "127.0.0.1:7777",
          "scope": "machine-overridable",
          "description": "host:port of a server started with `dvicode-server --listen` (tcp mode). Use an SSH tunnel for remote hosts."
        },
        "dvicode.server.tcpToken": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Token of the server (tcp mode): the value of `DVICODE_TOKEN` (or `--token`) the server was started with."
        },
        "dvicode.server.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Server log level (shown in the DVICode output channel). `debug` also shows how the build file and its argument files were read and, without a build file, which folders auto-configuration skipped and why; `trace` lists every file and the compile order."
        },
        "dvicode.server.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Extra arguments for dvicode-server."
        },
        "dvicode.pathMappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "local": {
                "type": "string",
                "description": "Folder as seen by VS Code, e.g. Z:\\\\proj or /Volumes/proj"
              },
              "remote": {
                "type": "string",
                "description": "Same folder as seen by the server, e.g. /home/me/proj"
              }
            },
            "required": [
              "local",
              "remote"
            ]
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Folder mappings between this machine and the server when they see the same files under different paths (Samba/NFS/SSHFS). WSL paths are mapped automatically."
        },
        "dvicode.buildFile": {
          "type": "string",
          "default": "",
          "description": "Build configuration file (relative to the workspace folder). Empty: .dvicode/default.build, else auto-configuration. `auto`: always auto-configure."
        },
        "dvicode.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Environment variables for the build configuration ($VAR expansion), set on the server side."
        },
        "dvicode.uvmHome": {
          "type": "string",
          "default": "",
          "description": "UVM library location on the server (used by -uvm and auto-configuration when $UVM_HOME is not set)."
        },
        "dvicode.format.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Format SystemVerilog documents and selections (Format Document, Format Selection). The formatter changes whitespace only: indentation, trailing blanks and, when asked, runs of blank lines. A `.dvicode/format.json` in the project (the nearest above the file) overrides these settings key by key."
        },
        "dvicode.format.indentSize": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "maximum": 16,
          "markdownDescription": "Spaces per indentation level. Unset: the editor's tab size."
        },
        "dvicode.format.useTabs": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "markdownDescription": "Indent with tabs. Unset: as the editor inserts (`#editor.insertSpaces#`)."
        },
        "dvicode.format.indentCaseItems": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Indent `case` items one level inside their `case`."
        },
        "dvicode.format.listIndent": {
          "type": "string",
          "enum": [
            "indent",
            "align"
          ],
          "enumDescriptions": [
            "Lines inside parentheses (ports, parameters, arguments) one level in; lines already lined up after the `(` or under the line above are kept.",
            "Lines inside parentheses line up after the `(` when something follows it on its line."
          ],
          "default": "indent",
          "markdownDescription": "How lines inside parentheses are indented."
        },
        "dvicode.format.continuationIndent": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 4,
          "markdownDescription": "Levels added to the continuation lines of a statement. Continuation lines lined up by hand under the line above are kept."
        },
        "dvicode.format.preprocessorIndent": {
          "type": "string",
          "enum": [
            "keep",
            "column0",
            "indent"
          ],
          "enumDescriptions": [
            "Compiler directive lines (`ifdef, `include...) keep their indentation.",
            "Directive lines at column 0.",
            "Directive lines at the level of the code around them."
          ],
          "default": "keep",
          "markdownDescription": "Where compiler directive lines go. `` `define `` definitions are never changed."
        },
        "dvicode.format.trimTrailingWhitespace": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Remove trailing blanks (never inside block comments, strings, macro definitions, or before a `\\`)."
        },
        "dvicode.format.maxBlankLines": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "Blank lines kept in a row at most (0: all kept). Removing lines changes the line numbers `` `__LINE__ `` gives."
        },
        "dvicode.designHierarchy.showInactiveGenerate": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show the generate blocks and instances whose condition is proven false in the Design Hierarchy, marked *not elaborated*. Blocks whose condition cannot be evaluated are always shown, marked *undetermined*."
        },
        "dvicode.inlayHints.ports": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the port names of positional port connections (`u_fifo (clk, rst_n, ...)`) as inlay hints. Inlay hints as a whole follow `#editor.inlayHints.enabled#`."
        },
        "dvicode.inlayHints.parameters": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the parameter names of positional parameter values (`#(8, 4)`) as inlay hints."
        },
        "dvicode.inlayHints.arguments": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the argument names of positional arguments in function and task calls with two arguments or more as inlay hints. An argument that is just the argument's own name gets none."
        },
        "dvicode.maxProblems": {
          "type": "integer",
          "minimum": 0,
          "default": 1000,
          "description": "Maximum number of problems published after a full build. Open files are exempt from this limit; per-file limits (500 problems, of which 50 syntax errors) still apply. 0 means no limit."
        },
        "dvicode.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the LSP traffic in the DVICode trace output channel."
        }
      }
    },
