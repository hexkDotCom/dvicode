    "menus": {
      "editor/context": [
        {
          "command": "dvicode.expandMacro",
          "when": "editorLangId == systemverilog",
          "group": "navigation@90"
        },
        {
          "command": "dvicode.showIncludingFiles",
          "when": "editorLangId == systemverilog",
          "group": "navigation@91"
        }
      ],
      "view/title": [
        {
          "command": "dvicode.design.filter",
          "when": "view == dvicode.designHierarchy && !dvicode.design.filtered",
          "group": "navigation@1"
        },
        {
          "command": "dvicode.design.clearFilter",
          "when": "view == dvicode.designHierarchy && dvicode.design.filtered",
          "group": "navigation@1"
        },
        {
          "command": "dvicode.design.syncOn",
          "when": "view == dvicode.designHierarchy && !dvicode.design.sync",
          "group": "navigation@2"
        },
        {
          "command": "dvicode.design.syncOff",
          "when": "view == dvicode.designHierarchy && dvicode.design.sync",
          "group": "navigation@2"
        },
        {
          "command": "dvicode.design.previousOccurrence",
          "when": "view == dvicode.designHierarchy && dvicode.design.sync",
          "group": "occurrence@1"
        },
        {
          "command": "dvicode.design.nextOccurrence",
          "when": "view == dvicode.designHierarchy && dvicode.design.sync",
          "group": "occurrence@2"
        },
        {
          "command": "dvicode.design.filter",
          "when": "view == dvicode.designHierarchy && dvicode.design.filtered",
          "group": "filter@1"
        },
        {
          "command": "dvicode.verification.filter",
          "when": "view == dvicode.verificationHierarchy && !dvicode.verification.filtered",
          "group": "navigation@1"
        },
        {
          "command": "dvicode.verification.clearFilter",
          "when": "view == dvicode.verificationHierarchy && dvicode.verification.filtered",
          "group": "navigation@1"
        },
        {
          "command": "dvicode.verification.syncOn",
          "when": "view == dvicode.verificationHierarchy && !dvicode.verification.sync",
          "group": "navigation@2"
        },
        {
          "command": "dvicode.verification.syncOff",
          "when": "view == dvicode.verificationHierarchy && dvicode.verification.sync",
          "group": "navigation@2"
        },
        {
          "command": "dvicode.verification.previousOccurrence",
          "when": "view == dvicode.verificationHierarchy && dvicode.verification.sync",
          "group": "occurrence@1"
        },
        {
          "command": "dvicode.verification.nextOccurrence",
          "when": "view == dvicode.verificationHierarchy && dvicode.verification.sync",
          "group": "occurrence@2"
        },
        {
          "command": "dvicode.verification.filter",
          "when": "view == dvicode.verificationHierarchy && dvicode.verification.filtered",
          "group": "filter@1"
        },
        {
          "command": "dvicode.structure.filter",
          "when": "view == dvicode.structure && !dvicode.structure.filtered",
          "group": "navigation@1"
        },
        {
          "command": "dvicode.structure.clearFilter",
          "when": "view == dvicode.structure && dvicode.structure.filtered",
          "group": "navigation@1"
        },
        {
          "command": "dvicode.structure.syncOn",
          "when": "view == dvicode.structure && !dvicode.structure.sync",
          "group": "navigation@2"
        },
        {
          "command": "dvicode.structure.syncOff",
          "when": "view == dvicode.structure && dvicode.structure.sync",
          "group": "navigation@2"
        },
        {
          "command": "dvicode.structure.filter",
          "when": "view == dvicode.structure && dvicode.structure.filtered",
          "group": "filter@1"
        },
        {
          "command": "dvicode.verification.showObjects",
          "when": "view == dvicode.verificationHierarchy && !dvicode.verification.objects && dvicode.engine.objects",
          "group": "options@1"
        },
        {
          "command": "dvicode.verification.hideObjects",
          "when": "view == dvicode.verificationHierarchy && dvicode.verification.objects && dvicode.engine.objects",
          "group": "options@1"
        },
        {
          "command": "dvicode.verification.showPorts",
          "when": "view == dvicode.verificationHierarchy && !dvicode.verification.ports && dvicode.engine.objects",
          "group": "options@2"
        },
        {
          "command": "dvicode.verification.hidePorts",
          "when": "view == dvicode.verificationHierarchy && dvicode.verification.ports && dvicode.engine.objects",
          "group": "options@2"
        },
        {
          "command": "dvicode.files.filter",
          "when": "view == dvicode.compiledFiles && !dvicode.files.filtered",
          "group": "navigation@1"
        },
        {
          "command": "dvicode.files.clearFilter",
          "when": "view == dvicode.compiledFiles && dvicode.files.filtered",
          "group": "navigation@1"
        },
        {
          "command": "dvicode.files.syncOn",
          "when": "view == dvicode.compiledFiles && !dvicode.files.sync",
          "group": "navigation@2"
        },
        {
          "command": "dvicode.files.syncOff",
          "when": "view == dvicode.compiledFiles && dvicode.files.sync",
          "group": "navigation@2"
        },
        {
          "command": "dvicode.files.previousOccurrence",
          "when": "view == dvicode.compiledFiles && dvicode.files.sync",
          "group": "occurrence@1"
        },
        {
          "command": "dvicode.files.nextOccurrence",
          "when": "view == dvicode.compiledFiles && dvicode.files.sync",
          "group": "occurrence@2"
        },
        {
          "command": "dvicode.files.filter",
          "when": "view == dvicode.compiledFiles && dvicode.files.filtered",
          "group": "filter@1"
        },
        {
          "command": "dvicode.selectUvmTest",
          "when": "view == dvicode.verificationHierarchy",
          "group": "navigation@9"
        },
        {
          "command": "dvicode.selectDesignTop",
          "when": "view == dvicode.designHierarchy",
          "group": "navigation@9"
        },
        {
          "command": "dvicode.refreshViews",
          "when": "view == dvicode.designHierarchy || view == dvicode.verificationHierarchy || view == dvicode.compiledFiles",
          "group": "navigation@9"
        },
        {
          "command": "dvicode.rebuild",
          "when": "view == dvicode.compiledFiles",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "dvicode.copyHierarchyPath",
          "when": "view == dvicode.designHierarchy || view == dvicode.verificationHierarchy && viewItem =~ /^dvicode\\.verifNode/"
        },
        {
          "command": "dvicode.openComponentClass",
          "when": "view == dvicode.verificationHierarchy && viewItem =~ /^dvicode\\.verif(Node|Object)\\.class$/",
          "group": "inline"
        },
        {
          "command": "dvicode.openComponentClass",
          "when": "view == dvicode.verificationHierarchy && viewItem =~ /^dvicode\\.verif(Node|Object)\\.class$/"
        }
      ],
      "commandPalette": [
        {
          "command": "dvicode.copyHierarchyPath",
          "when": "false"
        },
        {
          "command": "dvicode.openComponentClass",
          "when": "false"
        },
        {
          "command": "dvicode.verification.showObjects",
          "when": "false"
        },
        {
          "command": "dvicode.verification.hideObjects",
          "when": "false"
        },
        {
          "command": "dvicode.verification.showPorts",
          "when": "false"
        },
        {
          "command": "dvicode.verification.hidePorts",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
