    "menus": {
      "editor/context": [
        {
          "command": "dvicode.expandMacro",
          "when": "editorLangId == systemverilog",
          "group": "navigation@90"
        },
        {
          "command": "dvicode.showIncludingFiles",
          "when": "editorLangId == systemverilog",
          "group": "navigation@91"
        },
        {
          "command": "dvicode.showChecks",
          "when": "editorLangId == systemverilog && dvicode.engine.checks",
          "group": "navigation@92"
        },
        {
          "command": "dvicode.showDrivers",
          "when": "editorLangId == systemverilog && dvicode.engine.accesses",
          "group": "navigation@93"
        },
        {
          "command": "dvicode.showLoads",
          "when": "editorLangId == systemverilog && dvicode.engine.accesses",
          "group": "navigation@94"
        },
        {
          "command": "dvicode.showCompileContext",
          "when": "(editorLangId == systemverilog || editorLangId == verilog) && dvicode.engine.compileContext",
          "group": "navigation@93"
        },
        {
