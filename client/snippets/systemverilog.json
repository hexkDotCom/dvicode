{
  "module": {
    "prefix": "module",
    "body": ["module ${1:name} #(", "  parameter int ${2:W} = ${3:8}", ") (", "  input  logic clk,", "  input  logic rst_n$0", ");", "", "endmodule : $1"],
    "description": "Module with parameters and ports"
  },
  "class": {
    "prefix": "class",
    "body": ["class ${1:name} extends ${2:base};", "", "  function new(string name = \"$1\");", "    super.new(name);", "  endfunction", "$0", "endclass : $1"],
    "description": "Class with a constructor"
  },
  "uvm_object": {
    "prefix": "uvm_object",
    "body": [
      "class ${1:my_item} extends ${2:uvm_sequence_item};",
      "  `uvm_object_utils($1)",
      "",
      "  rand bit [${3:7}:0] ${4:addr};",
      "",
      "  function new(string name = \"$1\");",
      "    super.new(name);",
      "  endfunction",
      "",
      "  virtual function string convert2string();",
      "    return \\$sformatf(\"$4=%0h\", $4);",
      "  endfunction",
      "endclass : $1"
    ],
    "description": "UVM object/sequence item"
  },
  "uvm_component": {
    "prefix": "uvm_component",
    "body": [
      "class ${1:my_comp} extends ${2:uvm_component};",
      "  `uvm_component_utils($1)",
      "",
      "  function new(string name, uvm_component parent);",
      "    super.new(name, parent);",
      "  endfunction",
      "",
      "  virtual function void build_phase(uvm_phase phase);",
      "    super.build_phase(phase);",
      "    $0",
      "  endfunction",
      "",
      "  virtual task run_phase(uvm_phase phase);",
      "  endtask",
      "endclass : $1"
    ],
    "description": "UVM component with build and run phases"
  },
  "uvm_sequence_item": {
    "prefix": "uvm_sequence_item",
    "body": [
      "class ${1:my_item} extends uvm_sequence_item;",
      "  rand bit [${2:31}:0] ${3:addr};",
      "  rand bit [${4:31}:0] ${5:data};",
      "",
      "  `uvm_object_utils_begin($1)",
      "    `uvm_field_int($3, UVM_ALL_ON)",
      "    `uvm_field_int($5, UVM_ALL_ON)",
      "  `uvm_object_utils_end",
      "",
      "  function new(string name = \"$1\");",
      "    super.new(name);",
      "  endfunction",
      "$0",
      "endclass : $1"
    ],
    "description": "UVM sequence item with field automation"
  },
  "uvm_sequence": {
    "prefix": "uvm_sequence",
    "body": [
      "class ${1:my_seq} extends uvm_sequence #(${2:my_item});",
      "  `uvm_object_utils($1)",
      "",
      "  function new(string name = \"$1\");",
      "    super.new(name);",
      "  endfunction",
      "",
      "  virtual task body();",
      "    $2 req;",
      "    repeat (${3:10}) begin",
      "      req = $2::type_id::create(\"req\");",
      "      start_item(req);",
      "      if (!req.randomize()) `uvm_error(get_type_name(), \"randomize failed\")",
      "      finish_item(req);",
      "    end",
      "    $0",
      "  endtask",
      "endclass : $1"
    ],
    "description": "UVM sequence with a body"
  },
  "uvm_driver": {
    "prefix": "uvm_driver",
    "body": [
      "class ${1:my_driver} extends uvm_driver #(${2:my_item});",
      "  `uvm_component_utils($1)",
      "",
      "  virtual ${3:my_if} vif;",
      "",
      "  function new(string name, uvm_component parent);",
      "    super.new(name, parent);",
      "  endfunction",
      "",
      "  virtual function void build_phase(uvm_phase phase);",
      "    super.build_phase(phase);",
      "    if (!uvm_config_db#(virtual $3)::get(this, \"\", \"vif\", vif))",
      "      `uvm_fatal(get_type_name(), \"no virtual interface\")",
      "  endfunction",
      "",
      "  virtual task run_phase(uvm_phase phase);",
      "    forever begin",
      "      seq_item_port.get_next_item(req);",
      "      $0",
      "      seq_item_port.item_done();",
      "    end",
      "  endtask",
      "endclass : $1"
    ],
    "description": "UVM driver"
  },
  "uvm_monitor": {
    "prefix": "uvm_monitor",
    "body": [
      "class ${1:my_monitor} extends uvm_monitor;",
      "  `uvm_component_utils($1)",
      "",
      "  virtual ${2:my_if} vif;",
      "  uvm_analysis_port #(${3:my_item}) ap;",
      "",
      "  function new(string name, uvm_component parent);",
      "    super.new(name, parent);",
      "  endfunction",
      "",
      "  virtual function void build_phase(uvm_phase phase);",
      "    super.build_phase(phase);",
      "    ap = new(\"ap\", this);",
      "    if (!uvm_config_db#(virtual $2)::get(this, \"\", \"vif\", vif))",
      "      `uvm_fatal(get_type_name(), \"no virtual interface\")",
      "  endfunction",
      "",
      "  virtual task run_phase(uvm_phase phase);",
      "    forever begin",
      "      $3 item = $3::type_id::create(\"item\");",
      "      $0",
      "      ap.write(item);",
      "    end",
      "  endtask",
      "endclass : $1"
    ],
    "description": "UVM monitor with an analysis port"
  },
  "uvm_agent": {
    "prefix": "uvm_agent",
    "body": [
      "class ${1:my_agent} extends uvm_agent;",
      "  `uvm_component_utils($1)",
      "",
      "  ${2:my_driver} drv;",
      "  ${3:my_monitor} mon;",
      "  uvm_sequencer #(${4:my_item}) sqr;",
      "",
      "  function new(string name, uvm_component parent);",
      "    super.new(name, parent);",
      "  endfunction",
      "",
      "  virtual function void build_phase(uvm_phase phase);",
      "    super.build_phase(phase);",
      "    mon = $3::type_id::create(\"mon\", this);",
      "    if (get_is_active() == UVM_ACTIVE) begin",
      "      drv = $2::type_id::create(\"drv\", this);",
      "      sqr = uvm_sequencer#($4)::type_id::create(\"sqr\", this);",
      "    end",
      "  endfunction",
      "",
      "  virtual function void connect_phase(uvm_phase phase);",
      "    if (get_is_active() == UVM_ACTIVE)",
      "      drv.seq_item_port.connect(sqr.seq_item_export);",
      "    $0",
      "  endfunction",
      "endclass : $1"
    ],
    "description": "UVM agent, active or passive"
  },
  "uvm_env": {
    "prefix": "uvm_env",
    "body": [
      "class ${1:my_env} extends uvm_env;",
      "  `uvm_component_utils($1)",
      "",
      "  ${2:my_agent} agt;",
      "  ${3:my_scoreboard} sb;",
      "",
      "  function new(string name, uvm_component parent);",
      "    super.new(name, parent);",
      "  endfunction",
      "",
      "  virtual function void build_phase(uvm_phase phase);",
      "    super.build_phase(phase);",
      "    agt = $2::type_id::create(\"agt\", this);",
      "    sb = $3::type_id::create(\"sb\", this);",
      "  endfunction",
      "",
      "  virtual function void connect_phase(uvm_phase phase);",
      "    agt.mon.ap.connect(sb.analysis_export);",
      "    $0",
      "  endfunction",
      "endclass : $1"
    ],
    "description": "UVM environment"
  },
  "uvm_test": {
    "prefix": "uvm_test",
    "body": [
      "class ${1:my_test} extends uvm_test;",
      "  `uvm_component_utils($1)",
      "",
      "  ${2:my_env} env;",
      "",
      "  function new(string name, uvm_component parent);",
      "    super.new(name, parent);",
      "  endfunction",
      "",
      "  virtual function void build_phase(uvm_phase phase);",
      "    super.build_phase(phase);",
      "    env = $2::type_id::create(\"env\", this);",
      "  endfunction",
      "",
      "  virtual task run_phase(uvm_phase phase);",
      "    ${3:my_seq} seq = $3::type_id::create(\"seq\");",
      "    phase.raise_objection(this);",
      "    seq.start(env.agt.sqr);",
      "    $0",
      "    phase.drop_objection(this);",
      "  endtask",
      "endclass : $1"
    ],
    "description": "UVM test"
  },
  "uvm_scoreboard": {
    "prefix": "uvm_scoreboard",
    "body": [
      "class ${1:my_scoreboard} extends uvm_scoreboard;",
      "  `uvm_component_utils($1)",
      "",
      "  uvm_analysis_imp #(${2:my_item}, $1) analysis_export;",
      "",
      "  function new(string name, uvm_component parent);",
      "    super.new(name, parent);",
      "  endfunction",
      "",
      "  virtual function void build_phase(uvm_phase phase);",
      "    super.build_phase(phase);",
      "    analysis_export = new(\"analysis_export\", this);",
      "  endfunction",
      "",
      "  virtual function void write($2 item);",
      "    $0",
      "  endfunction",
      "endclass : $1"
    ],
    "description": "UVM scoreboard with an analysis import"
  },
  "always_ff": {
    "prefix": "always_ff",
    "body": ["always_ff @(posedge ${1:clk} or negedge ${2:rst_n}) begin", "  if (!$2) begin", "    $3", "  end else begin", "    $0", "  end", "end"],
    "description": "Flip-flop process with asynchronous reset"
  },
  "always_comb": {
    "prefix": "always_comb",
    "body": ["always_comb begin", "  $0", "end"],
    "description": "Combinational process"
  },
  "covergroup": {
    "prefix": "covergroup",
    "body": ["covergroup ${1:cg} @(posedge ${2:clk});", "  ${3:cp}: coverpoint ${4:sig};", "endgroup : $1"],
    "description": "Covergroup"
  },
  "property": {
    "prefix": "property",
    "body": ["property ${1:p_name};", "  @(posedge ${2:clk}) disable iff (!${3:rst_n})", "  ${4:req} |-> ##[1:${5:3}] ${6:ack};", "endproperty", "${7:a_name}: assert property ($1);"],
    "description": "Concurrent assertion"
  }
}
